# Doxyfile — HardFOC Flux V1 HAL API Documentation
# ───────────────────────────────────────────────────────────────────────────────
# Generates HTML + class/call graphs for the HAL-level API and managers.
# The core/ submodule (handlers, drivers, utils) is excluded — its own Doxyfile
# is maintained upstream in hf-core.
# ───────────────────────────────────────────────────────────────────────────────

#---------------------------------------------------------------------------
# Project metadata
#---------------------------------------------------------------------------
PROJECT_NAME           = "HardFOC Flux V1 HAL"
PROJECT_BRIEF          = "Unified HAL API for the HardFOC Flux valve-control platform (ESP32-S3)"
PROJECT_NUMBER         =
PROJECT_LOGO           =
OUTPUT_DIRECTORY       = build/doxygen
HTML_OUTPUT            = html
CASE_SENSE_NAMES       = NO
GENERATE_TAGFILE       =

#---------------------------------------------------------------------------
# Input paths
#---------------------------------------------------------------------------
INPUT                  = lib/api \
                         lib/managers \
                         docs/_doxygen/mainpage.md

FILE_PATTERNS          = *.c *.cpp *.h *.hpp
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = docs/_doxygen/mainpage.md

EXCLUDE                = *build* *cmake-build-* *managed_components* *__pycache__* *.pyc
EXCLUDE_PATTERNS       = */build/* */cmake-build-*/* */.git/* */managed_components/* */__pycache__/* \
                         */lib/core/* */examples/esp32/scripts/* */docs/hf-development-handbook/*

#---------------------------------------------------------------------------
# Extraction
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = YES
FULL_PATH_NAMES        = NO
BUILTIN_STL_SUPPORT    = YES
TYPEDEF_HIDES_STRUCT   = YES
SORT_MEMBER_DOCS       = YES

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------
GENERATE_TODOLIST      = YES
GENERATE_BUGLIST       = YES
GENERATE_DEPRECATEDLIST = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO

#---------------------------------------------------------------------------
# HTML output
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
PAGE_OUTLINE_PANEL     = NO
SEARCHENGINE           = YES

#---------------------------------------------------------------------------
# Graphs (requires Graphviz / dot)
#---------------------------------------------------------------------------
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DOT_IMAGE_FORMAT       = svg
DOT_TRANSPARENT        = YES

#---------------------------------------------------------------------------
# Disabled output formats
#---------------------------------------------------------------------------
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO
